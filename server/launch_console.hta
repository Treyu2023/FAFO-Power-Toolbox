<html>
<head>
<title>AI Toolbox — Console</title>
<HTA:APPLICATION
    ID="AIToolboxConsole"
    APPLICATIONNAME="AI Toolbox Server"
    BORDER="thin"
    CAPTION="yes"
    SHOWINTASKBAR="yes"
    SINGLEINSTANCE="yes"
    SYSMENU="yes"
    WINDOWSTATE="normal"
    SCROLL="no"
/>
<style>body{font-family:Segoe UI;background:#050508;color:#e8e8ec;padding:16px;}</style>
<script language="VBScript">
Sub FixPath(p)
    If Len(p) > 2 And Mid(p, 1, 1) = "/" And Mid(p, 3, 1) = ":" Then
        FixPath = Mid(p, 2)
    Else
        FixPath = p
    End If
End Sub

Sub Window_OnLoad
    On Error Resume Next
    Dim fso, shell, dir, bat
    Set fso = CreateObject("Scripting.FileSystemObject")
    Set shell = CreateObject("WScript.Shell")
    dir = FixPath(fso.GetParentFolderName(document.location.pathname))
    shell.CurrentDirectory = dir
    bat = dir & "\start_console_now.bat"
    shell.Run "cmd /c """ & bat & """", 1, False
    window.setTimeout "window.close()", 800
End Sub
</script>
</head>
<body>Opening server console…</body>
</html>