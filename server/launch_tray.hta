<html>
<head>
<title>AI Toolbox — Starting</title>
<HTA:APPLICATION
    ID="AIToolboxLaunch"
    APPLICATIONNAME="AI Toolbox Server"
    BORDER="none"
    CAPTION="no"
    SHOWINTASKBAR="no"
    SINGLEINSTANCE="yes"
    SYSMENU="no"
    WINDOWSTATE="minimize"
    SCROLL="no"
/>
<style>body{font-family:Segoe UI;background:#050508;color:#00f3ff;text-align:center;padding:24px;}</style>
<script language="VBScript">
Sub FixPath(p)
    If Len(p) > 2 And Mid(p, 1, 1) = "/" And Mid(p, 3, 1) = ":" Then
        FixPath = Mid(p, 2)
    Else
        FixPath = p
    End If
End Sub

Sub Window_OnLoad
    On Error Resume Next
    Dim fso, shell, dir, bat
    Set fso = CreateObject("Scripting.FileSystemObject")
    Set shell = CreateObject("WScript.Shell")
    dir = FixPath(fso.GetParentFolderName(document.location.pathname))
    shell.CurrentDirectory = dir
    bat = dir & "\start_tray_now.bat"
    shell.Run "cmd /c """ & bat & """", 0, False
    window.setTimeout "window.close()", 1200
End Sub
</script>
</head>
<body>Starting AI Toolbox server…</body>
</html>