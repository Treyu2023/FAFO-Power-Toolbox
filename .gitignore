# =============================================================================
# FAFO Power Toolbox / AI HTML Toolbox — private repo hygiene
# Never commit secrets, local runtime data, or machine-specific noise.
# =============================================================================

# --- Secrets & credentials ---
.env
.env.*
*.pem
*.key
*.p12
*.pfx
server/security_config.json
# DPAPI secret store folders only — do NOT ignore Scripts\Modules\FAFO.Secrets
**/FAFO/Secrets/
**/Secrets/*.xml
credentials.json
token.json

# --- FAFO local runtime (generated) ---
Reports/
Logs/
Backups/
backups/
terminals/

# --- Per-device PC reports / viewer packs (NEVER commit another PC's dumps) ---
# Source of truth lives under %LOCALAPPDATA%\FAFO\Devices\<hostname>\
System Tools/PC Reports and Log Viewer/catalog.js
System Tools/PC Reports and Log Viewer/logs-data.js
System Tools/PC Reports and Log Viewer/device-local/
System Tools/PC Reports and Log Viewer/reports/
**/FAFO/Devices/

# --- Server local data ---
server/aitoolbox.db
server/aitoolbox.db-*
server/threat_intel.db
server/threat_intel.db-*
server/debug_runtime.log
server/startup.log
server/thumbnails/
server/quarantine/
server/__pycache__/
server/**/__pycache__/

# --- Logs & databases (anywhere) ---
*.log
*.db
*.db-shm
*.db-wal
Logs Gen Bank/

# --- Python (local venv only — never commit) ---
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.venv/
venv/
ENV/
.python-version.local
pip-wheel-metadata/

# --- OS / editor ---
desktop.ini
Thumbs.db
.DS_Store
.vscode/
.idea/
*.swp
*~

# --- Local scratch / one-off ---
New Text Document.txt
*.bak
*.tmp
*.temp
