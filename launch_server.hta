<html>
<head>
<HTA:APPLICATION SHOWINTASKBAR="no" WINDOWSTATE="minimize" BORDER="none" CAPTION="no" />
<script language="VBScript">
Sub FixPath(p)
    If Len(p) > 2 And Mid(p, 1, 1) = "/" And Mid(p, 3, 1) = ":" Then
        FixPath = Mid(p, 2)
    Else
        FixPath = p
    End If
End Sub
Sub Window_OnLoad
    Dim fso, shell, root, bat
    Set fso = CreateObject("Scripting.FileSystemObject")
    Set shell = CreateObject("WScript.Shell")
    root = FixPath(fso.GetParentFolderName(document.location.pathname))
    ps1 = root & "\Scripts\Start-FAFOServers.ps1"
    bat = root & "\START SERVER.bat"
    If fso.FileExists(ps1) Then
        shell.Run "powershell.exe -NoProfile -ExecutionPolicy Bypass -WindowStyle Hidden -File """ & ps1 & """ -ToolboxRoot """ & root & """ -Quiet", 0, False
    Else
        shell.Run """" & bat & """", 0, False
    End If
    window.setTimeout "window.close()", 1500
End Sub
</script>
</head><body style="font-family:Segoe UI;color:#00f3ff;background:#050508">Starting…</body></html>