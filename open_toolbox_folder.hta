<html>
<head>
<HTA:APPLICATION SHOWINTASKBAR="no" WINDOWSTATE="minimize" BORDER="none" />
<script language="VBScript">
Sub FixPath(p)
    If Len(p) > 2 And Mid(p, 1, 1) = "/" And Mid(p, 3, 1) = ":" Then
        FixPath = Mid(p, 2)
    Else
        FixPath = p
    End If
End Sub
Sub Window_OnLoad
    Dim fso, shell, root
    Set fso = CreateObject("Scripting.FileSystemObject")
    Set shell = CreateObject("WScript.Shell")
    root = FixPath(fso.GetParentFolderName(document.location.pathname))
    shell.Run "explorer.exe """ & root & """", 1, True
    window.close()
End Sub
</script>
</head><body></body></html>